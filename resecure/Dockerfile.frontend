# ==============================================================================
# ReSecure Frontend - Multi-Stage Container
# Image: Node 22-alpine Builder + Nginx 1.27-alpine Production Runtime
# Security: Hardened Security Headers, Unprivileged Non-Root Execution (UID 10001)
# Proxy: /api -> backend:8000
# Port: 3000
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build React/TypeScript Frontend
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /build

# Install dependencies with npm ci
COPY resecure/frontend/package.json resecure/frontend/package-lock.json ./
RUN npm ci

# Copy frontend source code and contracts
COPY resecure/frontend/ ./
COPY contracts/ ../contracts/

# Run TypeScript typecheck and Vite production build
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Hardened Unprivileged Nginx Runtime
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runner

# Create unprivileged system group and user (UID/GID 10001)
RUN addgroup -g 10001 -S resecure && \
    adduser -u 10001 -S resecure -G resecure

# Remove default nginx configurations and static files
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy hardened nginx configuration
COPY resecure/nginx.conf /etc/nginx/nginx.conf

# Prepare directories with non-root ownership
RUN mkdir -p /var/cache/nginx /var/log/nginx /tmp /usr/share/nginx/html && \
    chown -R resecure:resecure /var/cache/nginx /var/log/nginx /tmp /usr/share/nginx/html /etc/nginx

# Copy compiled static assets from builder stage
COPY --from=builder --chown=resecure:resecure /build/dist /usr/share/nginx/html

# Drop privileges to non-root user
USER resecure

# Expose web application port
EXPOSE 3000

# Automated healthcheck
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/health || exit 1

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
