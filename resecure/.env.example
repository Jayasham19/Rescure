# ==============================================================================
# ReSecure MVP v1.0 - Environment Configuration Template
# Tenets: Mathematical Invariance | Non-Destructive Isolation | Air-Gapped Local
# ==============================================================================
# SECURITY NOTICE:
# - Never commit production credentials, secrets, or cryptographic keys to git.
# - Copy this file to '.env' before starting local development or container deployment.
# - For production deployments, supply a high-entropy 256-bit secret for RESECURE_HMAC_SECRET.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Host interface for the Uvicorn ASGI server (use 0.0.0.0 inside containers)
RESECURE_HOST=127.0.0.1

# HTTP port for the backend REST API
RESECURE_PORT=8000

# Persistent storage directory for file isolation and temporary atomic staging
RESECURE_STORAGE_DIR=./data

# SQLite database file path (must support WAL mode)
RESECURE_DB_PATH=./resecure/database/resecure.db

# Master cryptographic secret key used for HMAC-SHA256 manifest authentication
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
RESECURE_HMAC_SECRET=resecure-local-dev-integrity-key-do-not-use-in-production

# Maximum permissible input file size in bytes (2 GiB bounded verification matrix)
# 2 GiB = 2 * 1024 * 1024 * 1024 bytes
RESECURE_MAX_FILE_SIZE_BYTES=2147483648

# Reed-Solomon Default Erasure Coding Redundancy Percentage (5 to 100)
RESECURE_DEFAULT_REDUNDANCY_PERCENT=20

# ------------------------------------------------------------------------------
# Frontend Service Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Target URL for backend REST API proxying and client requests
VITE_API_URL=http://localhost:8000

# Application display title
VITE_APP_TITLE=ReSecure Cybersecurity Resilience Console

# Port for local Vite dev / preview server
PORT=3000
